#!/usr/bin/env bash

validation(){

	if [[ "$1" = true || "$3" = true ]]; then

		if [[ "$1" = true ]]; then

			if [[ ! "$2" =~ https?://[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+ ]]; then

				echo "wrong url! enter valid url"
				exit
			else

        			if [[ "$3" = true ]]; then

                			if [[ -f "$4" ]]; then

						Starting_point "$2" "$4"
					else
						echo "File not found"
						exit 1
					fi

        			else
                			echo "Wordlist not given"
                			exit 1
        			fi
			fi
		else
        		echo ""
        		exit 1
		fi
	else 
		echo "Input Error! uses -u for url -w for wordlist"
		exit 1
	fi


}
Starting_point(){

	echo "==================================================="
	echo "	Mini Gobuster"
	echo "	Target	:  $1"
	echo "	Words	:  $(wc -w $2 | awk '{print $1}')"
	echo "===================================================="

	while read -r line
	do
		echo "$line"
	done < "$2"
}
while getopts ":u:w:c:" opts
do
	case "$opts" in
		u) url="$OPTARG"
		   u_give=true;;
		w) wordlist="$OPTARG"
		   w_give=true;;
		c) filter_status="$OPTARG"
		   c_give=true;;
	esac
done

validation "$u_give" "$url" "$w_give" "$wordlist"

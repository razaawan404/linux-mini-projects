#!/usr/bin/env bash

validation(){

	if [[ "$1" = true || "$3" = true ]]; then

		if [[ "$1" = true ]]; then

			if [[ ! "$2" =~ https?://[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+ ]]; then

				echo "wrong url! enter valid url"
				exit
			else

        			if [[ "$3" = true ]]; then

                			if [[ -f "$4" ]]; then

						Starting_point "$2" "$4"
					else
						echo "File not found"
						exit 1
					fi

        			else
                			echo "Wordlist not given"
                			exit 1
        			fi
			fi
		else
        		echo ""
        		exit 1
		fi
	else
		echo "Input Error! uses -u for url -w for wordlist"
		exit 1
	fi


}
Starting_point(){

	ok_status=0
	word_count=$(wc -w "$2" | awk '{print $1}')
	valid_status=()

	echo "==================================================="
	echo "	Mini Gobuster"
	echo "	Target	:  $1"
	echo "	Words	:  $word_count"
	echo "	Date	:  $(date +"%Y-%m-%d %H:%m")"
	echo "===================================================="
	echo -e "\n"

	while read -r line
	do
		status=$(curl -sI "$1"/"$line"/ | awk ' NR==1 {print $2}')

		if [[ "$status" = 200 ]]; then

			echo "[+] $status → /$line"
			((ok_status++))
			valid_status+=("/$line")

		elif [[ "$status" = 301 ]]; then

			echo "[+] $status → /$line"
			valid_status+=("/$line")

		elif [[ "$status" = 403 ]]; then

			echo "[+] $status → /$line"
			valid_status+=("/$line")

		elif [[ "$status" = 404 ]]; then

			printf "[-] %s → /%-20s %s\n" "$status" "$line" "(hidden, only shows with -v)"

		fi

	done < "$2"

	final_report $ok_status $word_count "$valid_status"
}
final_report(){

	local -n endpoint="$3"
	echo -e "\n"
	echo "===================================="

		for valid in "${endpoint[@]}"
		do
			echo "$valid"
		done

	echo "==================================="
	echo -e "\n"
	echo "====================================="

	printf "[*] %-10s : %s\n" "Found" "$1"
	printf "[*] %-10s : %s\n" "Tested" "$2"

	echo "====================================="
}
while getopts ":u:w:c:" opts
do
	case "$opts" in
		u) url="$OPTARG"
		   u_give=true;;
		w) wordlist="$OPTARG"
		   w_give=true;;
		c) filter_status="$OPTARG"
		   c_give=true;;
	esac
done

validation "$u_give" "$url" "$w_give" "$wordlist"

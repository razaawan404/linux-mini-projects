Starting_point(){

	ok_status=0
	word_count=$(wc -w "$2" | awk '{print $1}')
	ok_endpoints=()

	echo "==================================================="
	echo "	Mini Gobuster"
	echo "	Target	:  $1"
	echo "	Words	:  $word_count"
	echo "	Date	:  $(date +"%Y-%m-%d %H:%m")"
	echo "===================================================="
	echo -e "\n"

	while read -r line
	do
		status=$(curl -sI "$1"/"$line"/ | awk ' NR==1 {print $2}')

		if [[ "$status" = 200 ]]; then

			echo "[+] $status → /$line"
			((ok_status++))
			ok_endpoints+=("/$line")

		elif [[ "$status" = 301 ]]; then

			echo "[+] $status → /$line"
			ok_endpoints+=("/$line")

		elif [[ "$status" = 403 ]]; then

			echo "[+] $status → /$line"
			ok_endpoints+=("/$line")

		elif [[ "$status" = 404 ]]; then

			printf "[-] %s → /%-20s %s\n" "$status" "$line" "(hidden, only shows with -v)"

		fi

	done < "$2"

	final_report $ok_status $word_count ok_endpoints
}
final_report(){

	local -n endpoint="$3"
	echo -e "\n"
	echo -e "====================================\n"
	echo -e "\n[FOUND ENDPOINTS]\n"
		for valid in "${endpoint[@]}"
		do
			echo "[+] $valid"
		done

	echo -e "\n====================================="
	echo -e "\n"
	echo "====================================="

	printf "[*] %-10s : %s\n" "Found" "$1"
	printf "[*] %-10s : %s\n" "Tested" "$2"

	echo "====================================="
}
while getopts ":u:w:c:" opts
do
	case "$opts" in
		u) url="$OPTARG"
		   u_give=true;;
		w) wordlist="$OPTARG"
		   w_give=true;;
		c) filter_status="$OPTARG"
		   c_give=true;;
	esac
done

validate_flag_u "$u_give" "$url"
validate_flag_w "$w_give" "$wordlist"
validate_flag_c "$c_give" "$filter_status"

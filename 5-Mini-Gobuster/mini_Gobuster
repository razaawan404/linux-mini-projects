while getopts ":u:w:c:" opts
do
	case "$opts" in
		u) url="$OPTARG"
		   u_give=true;;
		w) wordlist="$OPTARG"
		   w_give=true;;
		c) filter_status="$OPTARG"
		   c_give=true;;
	esac
done

if [[ ! "$u_give" = true ]]; then

	echo "./mini_Gobuster: option requires an argument -- u"
	exit 1


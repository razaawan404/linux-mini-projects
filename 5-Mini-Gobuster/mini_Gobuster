#!/usr/bin/env bash

v_url=""
v_wlist=""
v_codes=""
filter_check=1

filtering(){


	if [[ ! "*$1*" == "$2" ]]; then 

		return 0
	else
		return 1
	fi
}

validate_flag_u(){

	if [[ ! "$1" =~ http://127.0.0.1:9000 ]] && [[ ! "$1" =~ https?://(www\.)?[a-zA-Z0-9.-]+\.[a-zA-Z0-9]{2,} ]] ; then
		echo "Invalid Url! enter correct url"
		exit 1
	fi

	echo "$1"
}

validate_flag_w(){

	if [[ ! -f "$1" ]];  then

		echo "Error! File Not Exist"
		exit 1
	fi

	echo "$1"
}
validate_flag_c(){

	if [[ "$1" == true ]]; then

		if [[ ! "$2" =~ ^[0-9,]+$ ]]; then

			echo "Error! wrong status code"
			exit 1
		fi

	fi
	echo "$2"
}

main(){

	v_url=$(validate_flag_u "$url")
	v_wlist=$(validate_flag_w "$wordlist")
	v_codes=$(validate_flag_c "$c_give" "$filter_status")

	scan $v_url "$v_wlist" $v_codes
}


